<project
    xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.eclipse.emf.validation</groupId>
    <artifactId>org.eclipse.emf.validation.releng</artifactId>
    <version>1.14.2-SNAPSHOT</version>
    <relativePath>..</relativePath>
  </parent>

  <artifactId>org.eclipse.emf.validation.promotion</artifactId>
  <packaging>pom</packaging>

  <properties>
    <eclipse.repo>https://download.eclipse.org/releases/latest</eclipse.repo>
    <justj.tools.repo>https://download.eclipse.org/justj/tools/updates/nightly/latest</justj.tools.repo>
    <org.eclipse.storage.user>genie.emfservices</org.eclipse.storage.user>
    <org.eclipse.justj.p2.manager.target>modeling/emf/validation</org.eclipse.justj.p2.manager.target>
    <org.eclipse.justj.p2.manager.relative>updates</org.eclipse.justj.p2.manager.relative>
    <org.eclipse.justj.p2.manager.args>-remote ${org.eclipse.storage.user}@projects-storage.eclipse.org:/home/data/httpd/download.eclipse.org/${org.eclipse.justj.p2.manager.target}</org.eclipse.justj.p2.manager.args>
    <org.eclipse.justj.p2.manager.extra.args></org.eclipse.justj.p2.manager.extra.args>
    <org.eclipse.justj.p2.manager.build.url>http://www.example.com/</org.eclipse.justj.p2.manager.build.url>
    <maven.build.timestamp.format>yyyyMMddHHmm</maven.build.timestamp.format>
    <build.type>nightly</build.type>
  </properties>

  <build>
    <plugins>
      <plugin>
        <groupId>org.eclipse.tycho</groupId>
        <artifactId>tycho-eclipse-plugin</artifactId>
        <version>${tycho.version}</version>
        <configuration>
          <executionEnvironment>JavaSE-25</executionEnvironment>
          <dependencies>
            <dependency>
              <artifactId>org.eclipse.justj.p2</artifactId>
              <type>eclipse-plugin</type>
            </dependency>
            <dependency>
              <artifactId>org.apache.felix.scr</artifactId>
              <type>eclipse-plugin</type>
            </dependency>
          </dependencies>
          <repositories>
            <repository>
              <id>eclipse.repo</id>
              <layout>p2</layout>
              <url>${eclipse.repo}</url>
            </repository>
            <repository>
              <id>justj.tools.repo</id>
              <layout>p2</layout>
              <url>${justj.tools.repo}</url>
            </repository>
          </repositories>
        </configuration>
        <executions>
          <execution>
            <id>promote</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>eclipse-run</goal>
            </goals>
            <configuration>
              <argLine></argLine>
              <appArgLine>
                -consoleLog
                -application org.eclipse.justj.p2.manager
                -data @None
                -nosplash
                ${org.eclipse.justj.p2.manager.args}
                -retain 5
                -label "EMF Validation"
                -build-url ${org.eclipse.justj.p2.manager.build.url}
                -root ${project.build.directory}/validation-sync
                -relative ${org.eclipse.justj.p2.manager.relative}
                -version-iu org.eclipse.emf.validation.sdk.feature.group
                -commit https://github.com/eclipse-emfservices/emf-validation/commit/${commit.id}
                -target-url https://download.eclipse.org/modeling/emf/validation
                -promote ${project.basedir}/../../org.eclipse.emf.validation.repository/target/repository
                -timestamp ${build.timestamp}
                -type ${build.type}
                -favicon https://raw.githubusercontent.com/eclipse-emfservices/emf-validation/master/features/org.eclipse.emf.validation-feature/modeling32.png
                -body-image https://www.eclipse.org/modeling/emf/images/emf_logo.png
                -breadcrumb "Modeling https://www.eclipse.org/modeling"
                -breadcrumb "EMF https://www.eclipse.org/modeling/emf"
                -breadcrumb "EMF Services https://projects.eclipse.org/projects/modeling.emfservices"
                -mapping validation->Validation
                ${org.eclipse.justj.p2.manager.extra.args}
              </appArgLine>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
